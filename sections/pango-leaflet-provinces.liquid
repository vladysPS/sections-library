<!-- pango-leaflet-provinces.liquid -->
<!-- this is an interactive map done with LEAFLET
for the details of bulding this section go to :
1) https://leafletjs.com/examples/quick-start/
2) https://leafletjs.com/examples/geojson/
3) https://leafletjs.com/examples/choropleth/

In order to load the provinces data acces the leaflet-EU_data.js file in the assets folder. 
This file contains the GeoJSON data for the regions of the SELECTED countries; the countries
you only want to show as a backdrop live in leaflet-EU_data_not_selected.js, one outline each. 
The data is loaded into the map using the L.geoJson() method, which takes the GeoJSON data and adds it to the map as a layer.
-->

<section class="p-{{ section.id }}">
 <div class="map-wrapper">
   <div id="map"></div>
 </div> 
</section>


<style>
.p-{{ section.id }}{
    .map-wrapper{
        padding:3rem;
        display: grid;
        align-items: center;
        justify-items: center;
        
    }
    #map { 
        height: 480px; 
        max-width: 950px;
        width: 100%;
    }
}

@media(min-width:768px){
 .p-{{ section.id }}{
  
 }
}

</style>

{% comment %}  GeoJSON data: defines window.provincesData (selected countries, split
      into regions) and window.notSelectedData (whole-country outlines) {% endcomment %}  
<script src="{{ 'leaflet-EU_data.js' | asset_url }}"></script>
<script src="{{ 'leaflet-EU_data_not_selected.js' | asset_url }}"></script>

<script>

  let westernEurope = L.latLngBounds(
    [35.8, -11.0],  // south-west corner (south of Spain, west of Portugal)
    [56.2,  13.5]   // north-east corner (north of the UK, east of Germany)
  );

  let map = L.map('map', {
    maxBounds: westernEurope.pad(0.25), // don't let the user drag off to Asia
    maxBoundsViscosity: 0.8,
    minZoom: 4,
    maxZoom: 12
  });

  map.fitBounds(westernEurope);

  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
}).addTo(map);

  
  window.addEventListener('resize', function () {
    map.invalidateSize();
    map.fitBounds(westernEurope);
  });

// provincesData comes from assets/leaflet-EU_data.js and notSelectedData from
// assets/leaflet-EU_data_not_selected.js (both loaded just above).
// Each file gets its own L.geoJson layer, so each one gets its own style.

// SELECTED countries: the regions you can hover and click.
function addColorsToMap(feature) {
    return {
        fillColor: '#7AA2C4',
        weight: 2,
        opacity: 1,
        color: 'white',
        dashArray: '3',
        fillOpacity: 0.7
    };
}

// NOT-SELECTED countries: a muted backdrop, no interaction.
function addColorsToNotSelectedMap(feature) {
    return {
        fillColor: '#D96C6C',
        weight: 1,
        opacity: 1,
        color: 'white',
        dashArray: '3',
        fillOpacity: 0.25
    };
}

// Only one province is highlighted at a time, and we keep a reference to it.
// Fast hovering can swallow a mouseout (bringToFront() re-orders the SVG paths
// under the cursor), which used to leave the thick border painted for good.
// Clearing the previous one on every mouseover makes a missed event harmless.
let highlighted = null;

function clearHighlight() {
    if (!highlighted) return;
    geojson.resetStyle(highlighted);
    highlighted = null;
}

function highlightFeature(e) {
    var layer = e.target;
    if (layer === highlighted) return;

    clearHighlight();
    highlighted = layer;

    layer.setStyle({
        weight: 5,
        color: '#666',
        dashArray: '',
        fillOpacity: 0.7
    });

    layer.bringToFront();
}

function resetHighlight(e) {
    if (e.target === highlighted) clearHighlight();
}
// ADD IN THIS FUNCTION THE FUNCTINALITY YOU WANT TO DO WHEN A PROVINCE IS CLICKED
function zoomToFeature(e) {
    map.flyToBounds(e.target.getBounds(), {
        padding: [80, 80],  // breathing room around the province
        maxZoom: 7,         // don't zoom past this, however small the province
        duration: 0.6
    });
    hazEstoCuandoProvinciaClicada(e)
  }
  // ADD HERE THE FUNCTINALITY YOU WANT TO DO WHEN A PROVINCE IS CLICKED
function hazEstoCuandoProvinciaClicada(e){
  console.log(e.target.feature.properties.name);
}

/* LOADS THE MAIN FUNCTIONALITY OF THE MAP */

function onEachFeature(feature, layer) {
    layer.on({
        mouseover: highlightFeature,
        mouseout: resetHighlight,
        click: zoomToFeature
    });
}

// Added first so it stays under the selected regions. interactive:false keeps
// it out of every mouse event, so it can never reach highlightFeature/
// clearHighlight (which reset styles against the `geojson` layer only).
notSelectedGeojson = L.geoJson(notSelectedData, {
    style: addColorsToNotSelectedMap,
    interactive: false
}).addTo(map);

geojson = L.geoJson(provincesData, {
    style: addColorsToMap,
    onEachFeature: onEachFeature
}).addTo(map);

// Safety net: leaving the map altogether (fast flick out of the container, or
// out of the browser window) can also skip the province's mouseout.
// mouseleave doesn't bubble, so this only fires for the map itself.
map.getContainer().addEventListener('mouseleave', clearHighlight);


</script>


