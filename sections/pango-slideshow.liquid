      "unit": "px"
    },
    {
      "type": "range",
      "id": "content_max_width_desktop",
      "label": "Content Max Width Desktop",
      "min": 300,
      "max": 1200,
      "step": 10,
      "default": 700,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "content_positioning_desktop",
      "label": "Content Positioning Desktop",
      "options": [
        {
          "value": "top_left",
          "label": "Top Left"
