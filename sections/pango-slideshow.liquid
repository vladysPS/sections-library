      "label": "Title Font Size Desktop",
      "min": 14,
      "max": 100,
      "step": 2,
      "default": 70,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "subtitle_font_size_desktop",
      "label": "Subtitle Font Size Desktop",
      "min": 14,
      "max": 100,
      "step": 2,
      "default": 34,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "content_text_align_desktop",
      "label": "Content Text Align Desktop",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "center"
        },
        {
          "value": "right",
          "label": "right"
        }
