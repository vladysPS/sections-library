    {
      "type": "paragraph",
      "content": "____________________________"
    },
    {
      "type": "range",
      "id": "section_padding_top_desktop",
      "label": "Padding top desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_padding_bottom_desktop",
      "label": "Padding bottom desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0,
      "unit": "px"
    }
  ], 
  "blocks": [
    {
      "type": "slide-image",
      "name": "Slide Image",
      "settings": [
        {
            "type": "image_picker",
            "id": "image_mobile",
            "label": "Imagen mobile"
