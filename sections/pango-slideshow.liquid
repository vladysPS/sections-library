<!-- pango-slideshow.liquid -->

{% assign ss = section.settings %}

<section class="p-{{ section.id }}">   
	<div class="p-inner">     
		<div class="content"      
			data-mobile-positioning="{{ section.settings.content_positioning_mobile }}"
			data-desktop-positioning="{{ section.settings.content_positioning_desktop }}"
		>
			<span class="p-overlay"></span>
			<div class="content-inner">
				{% if ss.title %}
					<p  class="content-title">{{ ss.title }}</p>
				{% endif %}
				{% if ss.subtitle %}
					<p class="content-subtitle">{{ ss.subtitle }}</p>
				{% endif %}

				<div class="buttons-wrapper">
					{% if ss.button_1 != blank and ss.button_1_url != blank %}
						<a href="{{ ss.button_1_url }}" class="button button--outline">{{ ss.button_1}}</a>
					{% endif %}
					{% if ss.button_2 != blank and ss.button_2_url != blank %}
						<a href="{{ ss.button_2_url }}" class="button button--outline">{{ ss.button_2}}</a>
					{% endif %}
				</div>
			</div>
		</div>

		<div class="swiper mySwiper">
			<div class="swiper-wrapper">
				{%- for block in section.blocks -%}
                    {% if block.type == "slide-image" %}
                        {%- assign image_mobile = block.settings.image_mobile -%}
                        {%- assign image_desktop = block.settings.image_desktop -%}
                        <div class="swiper-slide">
                            {{ image_mobile | image_url: width: image_mobile.width | image_tag: class: 'hideOnDesktop', loading: 'lazy' }}
                            {{ image_desktop | image_url: width: image_desktop.width | image_tag: class: 'hideOnMobile', loading: 'lazy' }}
                        </div>                        
                    {% endif %}
                    {% if block.type == "slide-video" %}
                    {%- assign video_mobile = block.settings.video_mobile -%}
                    {%- assign video_desktop = block.settings.video_desktop -%}
                        <div class="swiper-slide">
                            {{ video_mobile | video_tag: autoplay: true, loop: true, muted: true, class: 'hideOnDesktop' }}
                            {{ video_desktop | video_tag: autoplay: true, loop: true, muted: true, class: 'hideOnMobile' }}
                        </div>                    
                    {% endif %}    
				{%- endfor -%}
			</div>
		</div>
		<div class="swiper-pagination"></div>
	</div>
</section>

{% # ————————————————————————————————————————————————————————————————————————————————%}  
{% #                                CONTENT + OVERLAY                                %}
{% # ————————————————————————————————————————————————————————————————————————————————%}
<style>

 
.p-{{ section.id }}{
    padding-top:{{ ss.section_padding_top_mobile}}px;
    padding-bottom:{{ ss.section_padding_bottom_mobile}}px;
    .hideOnDesktop{
        display:block;
    }
    .hideOnMobile{
        display:none;
    }

	.p-inner{
		height: {{ ss.section_height_mobile }}vh; 
		position:relative;

		/* -----------------  content ----------------- */
		.content{
			position:absolute;
			top: 0;
			width: 100%;
			height: 100%;
			display: flex;
			align-items: center;
			padding:{{ ss.content_padding_mobile}}px;
			z-index: 1;

			.content-inner{
				text-align:{{ss.content_text_align_mobile}};
				
				.content-title{
					color:{{ss.color_text}};
					font-size:{{ss.title_font_size_mobile}}px;
					margin: auto;
					line-height: normal;
				}
				.content-subtitle{
					color:{{ss.color_text}};
					font-size:{{ss.subtitle_font_size_mobile}}px;
					margin: auto;
					line-height: normal;
				}
				.buttons-wrapper{
					margin-top:20px;
					display: flex;
					flex-wrap: wrap;
					gap:16px;
					justify-content: {{ss.content_text_align_mobile}};
	
					.button{
						border-color: {{ss.color_text}};
						color:{{ss.color_text}};
						min-width: 250px;
						font-size:16px;
						opacity:1;
					}
				}
			}
			/* -----------------  overlay ----------------- */
			.p-overlay{
				--content-over-media-overlay: {{ ss.overlay_color.rgb }} / {{ ss.overlay_opacity | divided_by: 100.0 }};
				--other-color:{% if ss.full_section_overlay %}rgb(var(--content-over-media-overlay)){% else %} rgba(255,255,255,0){% endif %};
				position:absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				display: block;
				background:linear-gradient({{ss.gradient_overlay_degrees}}deg, var(--other-color) {{ ss.gradient_overlay_percentage }}%, rgb(var(--content-over-media-overlay)));
			}
		}
		.content[data-mobile-positioning="top_left"] { align-items: flex-start; justify-content: flex-start; }
		.content[data-mobile-positioning="top_center"] { align-items: flex-start; justify-content: center; }
		.content[data-mobile-positioning="top_right"] { align-items: flex-start; justify-content: flex-end; }
		
		.content[data-mobile-positioning="middle_left"] { align-items: center; justify-content: flex-start; }
		.content[data-mobile-positioning="middle_center"] { align-items: center; justify-content: center; }
		.content[data-mobile-positioning="middle_right"] { align-items: center; justify-content: flex-end; }
		
		.content[data-mobile-positioning="bottom_left"] { align-items: flex-end; justify-content: flex-start; }
		.content[data-mobile-positioning="bottom_center"] { align-items: flex-end; justify-content: center; }
		.content[data-mobile-positioning="bottom_right"] { align-items: flex-end; justify-content: flex-end; }
		/* -----------------  swiper ----------------- */
		.swiper{
			height: 100%;
			z-index: 0;
			img{
				width: 100%;
				height: 100%;
				object-fit:cover;
			}
            video{
                width:100%;
                height: 100%;
                object-fit: cover;
            }
		}
		.swiper-pagination {
			text-align: right;
			padding-right: 5%;
			.swiper-pagination-bullet {
				--swiper-pagination-color: #ffffff;
				--swiper-pagination-bullet-inactive-color: #ffffff88;
				border: 1px solid #d8d8d8; 
				opacity: 1;
			}
		}
	}
}
@media(min-width:768px){
    .p-{{ section.id }}{
		padding-top:{{ ss.section_padding_top_desktop}}px;
		padding-bottom:{{ ss.section_padding_bottom_desktop}}px;
        .hideOnDesktop{
            display:none;
        }
        .hideOnMobile{
            display:block;
        }
		.p-inner{
			height: {{ ss.section_height_desktop }}vh; 

			.content{
				padding:{{ ss.content_padding_desktop}}px;
			
				.content-inner{
					z-index: 1;
					text-align:{{ss.content_text_align_desktop}};
          width:100%;
					max-width:{{ ss.content_max_width_desktop}}px;
					.content-title{
						font-size:{{ss.title_font_size_desktop}}px;
					}
					.content-subtitle{
						font-size:{{ss.subtitle_font_size_desktop}}px;
					}
					.buttons-wrapper{		 
						justify-content: {{ss.content_text_align_desktop}};
						{%  if ss.max_space_between_buttons %}
							justify-content:space-between;
						{%  endif %}
					}
				}
			}
			.content[data-desktop-positioning="top_left"] { align-items: flex-start; justify-content: flex-start; }
			.content[data-desktop-positioning="top_center"] { align-items: flex-start; justify-content: center; }
			.content[data-desktop-positioning="top_right"] { align-items: flex-start; justify-content: flex-end; }
		
			.content[data-desktop-positioning="middle_left"] { align-items: center; justify-content: flex-start; }
			.content[data-desktop-positioning="middle_center"] { align-items: center; justify-content: center; }
			.content[data-desktop-positioning="middle_right"] { align-items: center; justify-content: flex-end; }
		
			.content[data-desktop-positioning="bottom_left"] { align-items: flex-end; justify-content: flex-start; }
			.content[data-desktop-positioning="bottom_center"] { align-items: flex-end; justify-content: center; }
			.content[data-desktop-positioning="bottom_right"] { align-items: flex-end; justify-content: flex-end; }
		}
    }    
}
</style>


<script>
document.addEventListener('slider:loaded', ()=>{
    new Swiper(".p-{{ section.id }} .mySwiper", {
      autoplay: true,
      loop:true,
	  slidesPerView: 1,
	  spaceBetween: 0,
      pagination: {
        el: '.p-{{ section.id }} .swiper-pagination',
        type: 'bullets',
        clickable	:true,
      },
    });    
})
</script>
 



