{% #                                      SCHEMA                                     %}
{% # ————————————————————————————————————————————————————————————————————————————————%}  
{% schema %}
  {
  "name": "Pango Slideshow",
  "settings": [
    {
      "type": "header",
      "content": "CONTENT"
    },
	{
	  "type": "color",
	  "id": "color_text",
	  "label": "Color text and buttons",
	  "default": "#FFFFFF"
	},
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Lorem ipsum odor amet, consectetuer adipiscing elit."
    },
    {
      "type": "text",
      "id": "button_1",
      "label": "Button 1 Text",
      "default": "MAN"
    },
    {
      "type": "url",
      "id": "button_1_url",
      "label": "Button 1 Url",
    },
    {
      "type": "text",
      "id": "button_2",
      "label": "Button 2 Text",
      "default": "WOMAN"
    },
    {
      "type": "url",
      "id": "button_2_url",
      "label": "Button 2 Url",
    },
    {
      "type": "header",
      "content": "SECTION HEIGHT"
    },
    {
      "type": "range",
      "id": "section_height_mobile",
      "label": "Height Mobile",
      "min": 30,
      "max": 120,
      "step": 2,
      "default": 90,
      "unit": "vh"
    },    
    {
      "type": "range",
      "id": "section_height_desktop",
      "label": "Height Desktop",
      "min": 30,
      "max": 120,
      "step": 2,
      "default": 90,
      "unit": "vh"
    },
    {
      "type": "header",
      "content": "CONTENT MOBILE"
    },
    {
      "type": "range",
      "id": "title_font_size_mobile",
      "label": "Title Font Size Mobile",
      "min": 14,
      "max": 100,
      "step": 2,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "subtitle_font_size_mobile",
      "label": "Subtitle Font Size Mobile",
      "min": 14,
      "max": 100,
      "step": 2,
      "default": 26,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "content_text_align_mobile",
      "label": "Content Text Align Mobile",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "center"
        },
        {
          "value": "right",
          "label": "right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_padding_mobile",
      "label": "Content Padding Mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "content_positioning_mobile",
      "label": "Content Positioning",
      "options": [
        {
          "value": "top_left",
          "label": "Top Left"
        },
        {
          "value": "top_center",
          "label": "Top Center"
        },
        {
          "value": "top_right",
          "label": "Top Right"
        },
        {
          "value": "middle_left",
          "label": "Middle Left"
        },
        {
          "value": "middle_center",
          "label": "Middle Center"
        },
        {
          "value": "middle_right",
          "label": "Middle Right"
        },
        {
          "value": "bottom_left",
          "label": "Bottom Left"
        },
        {
          "value": "bottom_center",
          "label": "Bottom Center"
        },
        {
          "value": "bottom_right",
          "label": "Bottom Right"
        }
      ],
      "default": "middle_center"
